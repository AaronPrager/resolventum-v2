# Postgres. On Vercel use a pooled URL here and the direct URL in DIRECT_URL.
DATABASE_URL="postgresql://user@localhost:5432/resolventum_v2"
DIRECT_URL="postgresql://user@localhost:5432/resolventum_v2"

# Session cookies are random tokens stored hashed; no signing secret is needed.

# Outgoing email (statements, homework links, parent updates, password reset). Optional but needed for resets.
RESEND_API_KEY=""
EMAIL_FROM="Resolventum <mail@yourdomain.com>"

# Set to "false" to close self-serve sign-up.
# New schools can sign up only when this is "true". Anything else keeps sign-up closed.
REGISTRATION_OPEN="false"

# AI features (parent updates, homework feedback drafts, receipt reading). Optional.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-pro"

# Development only: skip the sign-in page on localhost. "true" signs in as the first owner,
# an email signs in as that user. Ignored outside NODE_ENV=development.
DEV_AUTO_LOGIN=""

# Vercel Cron calls /api/cron with this bearer token.
CRON_SECRET=""

# Only for the import and verify scripts on a developer machine.
# SOURCE_DATABASE_URL="postgresql://user@localhost:5432/resolventum_prod_copy"
